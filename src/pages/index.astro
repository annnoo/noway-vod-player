---
// Style Imports
import '../styles/global.css';

// Component Imports
import Layout from '../layouts/Layout.astro';
import VodGrid from '../components/react/VodGrid';
---

<Layout title="VOD Player - Stream Archive" description="Experience stream VOD archives with interactive multi-track timelines, synchronized Spotify music overlays, and automatic match tracking.">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex flex-col justify-center min-h-[75vh]">
		
		<!-- Coherent Esports Mayhem Header Section -->
		<header class="text-center mb-10 mt-8 md:mt-0">
			<h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter text-white mb-4 italic">
				VODS <span class="text-brand drop-shadow-[0_0_15px_var(--color-brand-glow)]">// 4u</span>
			</h1>
			
			<a href="https://twitch.tv/noway4u_sir" target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-1 bg-brand text-darkbg font-black uppercase tracking-widest skew-x-[-12deg] italic text-xs hover:scale-105 transition-transform shadow-[0_0_10px_var(--color-brand-glow)] cursor-pointer">
				Noway4u_sir
			</a>

			<!--
			<div class="mt-8 flex justify-center px-4">
				<div class="inline-flex flex-col items-center gap-3 px-4 sm:px-6 py-3.5 bg-[#0c0c0c]/70 backdrop-blur-sm border border-white/10 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.4)] max-w-full">
					<div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-3 max-w-full">
						<span class="text-[9px] md:text-[10px] uppercase tracking-[0.35em] text-white/40 font-black italic">unterstützt von</span>
						<span class="text-xs font-black uppercase tracking-wider text-brand italic">Noway Community Archives</span>
					</div>
				</div>
			</div>
			<div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
				<div class="inline-flex items-center gap-4 sm:gap-5 bg-[#0c0c0c]/70 backdrop-blur-sm border border-white/10 px-5 sm:px-6 py-3 rounded-full shadow-[0_4px_20px_rgba(0,0,0,0.4)]">
					<span class="inline-flex items-center gap-2.5">
						<span class="text-brand text-sm drop-shadow-[0_0_6px_var(--color-brand-glow)]">🏆</span>
						<span class="text-white font-black uppercase tracking-[0.2em] text-[11px] sm:text-sm italic">Stream Archives</span>
					</span>
					<span class="w-px h-5 bg-white/15"></span>
					<span class="inline-flex items-center gap-2.5">
						<span class="text-yellow-500 text-sm drop-shadow-[0_0_6px_rgba(234,179,8,0.5)]">⏱️</span>
						<span class="text-white font-black uppercase tracking-[0.2em] text-[11px] sm:text-sm italic">Interactive Timelines</span>
					</span>
				</div>
</div>

			--!-->
		</header>
		
		<!-- VOD Grid Integration -->
		<div class="border-t border-white/5 pt-10">
			<VodGrid username="noway4u_sir" limit={6} client:load />
		</div>
	</div>
</Layout>
