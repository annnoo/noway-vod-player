---
// Style Imports
import '../styles/global.css';

// Component Imports
import Layout from '../layouts/Layout.astro';
import TwitchChannelEmbed from '../components/vod/TwitchChannelEmbed.svelte';
---
<Layout title="VOD Player" description="View Twitch VODs with interactive event timelines">
    <script src= "https://player.twitch.tv/js/embed/v1.js"></script>
	<div class="container mx-auto p-4 md:p-6 max-w-7xl">
		<!-- Hero Section -->
		<div class="text-center mb-16 mt-8 md:mt-12">
			<h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter text-white mb-6 italic skew-x-[-12deg]">
				VOD <span class="text-brand drop-shadow-[0_0_15px_var(--color-brand-glow)]">PLAYER</span>
			</h1>
			<p class="text-base md:text-xl text-white/70 mb-8 max-w-2xl mx-auto font-medium">
				Experience Twitch VODs like never before with interactive event timelines, 
				synchronized playback, and beautiful visualizations.
			</p>
			<div class="flex justify-center gap-4">
				<a href="/vod" class="px-8 py-3 bg-brand text-slate-950 font-black uppercase tracking-widest skew-x-[-12deg] italic text-sm hover:scale-105 transition-all shadow-[0_0_15px_var(--color-brand-glow)]">
					📺 Browse VODs
				</a>
			</div>
		</div>
		
		<!-- Demo Section -->
		<div class="mb-16">
			<div class="bg-[#0c0c0c] border border-white/10 rounded-[32px] p-6 sm:p-8 shadow-xl">
				<h2 class="text-xl md:text-2xl font-black uppercase tracking-widest text-brand mb-6 text-center italic skew-x-[-12deg] drop-shadow-[0_0_8px_var(--color-brand-glow)]">
					🎬 Live Demo
				</h2>
				<div class="rounded-2xl overflow-hidden shadow-2xl border border-white/5 bg-black">
					<TwitchChannelEmbed client:load video="2481364998" width="100%" height="500px" />
				</div>
			</div>
		</div>
		
		<!-- Features Section -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
			<div class="bg-[#0c0c0c] border border-white/10 p-6 rounded-[32px] hover:border-brand/40 shadow-xl transition-all duration-300 transform-gpu hover:-translate-y-1">
				<div class="text-3xl mb-4">⚡</div>
				<h3 class="text-lg font-black uppercase tracking-wider text-brand italic skew-x-[-12deg] mb-2 drop-shadow-[0_0_5px_var(--color-brand-glow)]">Real-time Sync</h3>
				<p class="text-gray-400 text-sm font-semibold leading-relaxed">Perfectly synchronized event timeline with video playback</p>
			</div>
			<div class="bg-[#0c0c0c] border border-white/10 p-6 rounded-[32px] hover:border-brand/40 shadow-xl transition-all duration-300 transform-gpu hover:-translate-y-1">
				<div class="text-3xl mb-4">🎯</div>
				<h3 class="text-lg font-black uppercase tracking-wider text-brand italic skew-x-[-12deg] mb-2 drop-shadow-[0_0_5px_var(--color-brand-glow)]">Smart Navigation</h3>
				<p class="text-gray-400 text-sm font-semibold leading-relaxed">Jump to any moment instantly with intelligent bookmarks</p>
			</div>
			<div class="bg-[#0c0c0c] border border-white/10 p-6 rounded-[32px] hover:border-brand/40 shadow-xl transition-all duration-300 transform-gpu hover:-translate-y-1">
				<div class="text-3xl mb-4">🎮</div>
				<h3 class="text-lg font-black uppercase tracking-wider text-brand italic skew-x-[-12deg] mb-2 drop-shadow-[0_0_5px_var(--color-brand-glow)]">Game Events</h3>
				<p class="text-gray-400 text-sm font-semibold leading-relaxed">Track kills, deaths, objectives, and more automatically</p>
			</div>
		</div>
		
		<!-- Usage Section -->
		<div class="bg-[#0c0c0c] border border-white/10 rounded-[32px] p-6 sm:p-8 text-center max-w-3xl mx-auto shadow-xl">
			<h2 class="text-xl md:text-2xl font-black uppercase tracking-widest text-brand mb-6 italic skew-x-[-12deg] drop-shadow-[0_0_8px_var(--color-brand-glow)]">
				🚀 Get Started
			</h2>
			<div class="text-center flex flex-col items-center">
				<p class="text-white/80 mb-4 font-semibold text-sm">Navigate to any VOD by using the URL pattern:</p>
				<div class="inline-block skew-x-[-12deg] bg-[#050505] border border-white/10 px-6 py-3 shadow-inner">
					<code class="text-brand font-black tracking-widest text-base md:text-xl">
						/vod/[vodId]
					</code>
				</div>
				<p class="text-gray-450 mt-4 text-xs font-bold italic">
					Example: <span class="text-brand/80 font-mono">/vod/2483190129</span>
				</p>
			</div>
		</div>
	</div>
</Layout>
