---
// Style Imports
import '../styles/global.css';

// Component Imports
import Layout from '../layouts/Layout.astro';
import VodGrid from '../components/react/VodGrid';
---
<Layout title="VOD Player - Interactive Stream Archive" description="Experience stream VOD archives with interactive multi-track timelines, synchronized Spotify music overlays, and automatic match tracking.">
	<div class="container mx-auto p-4 md:p-6 max-w-6xl font-sans relative min-h-[90vh] flex flex-col justify-center">
		{/* Background glows */}
		<div class="absolute top-10 left-1/4 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl -z-10 pointer-events-none"></div>
		<div class="absolute bottom-10 right-1/4 w-72 h-72 bg-pink-500/5 rounded-full blur-3xl -z-10 pointer-events-none"></div>

		<!-- Hero Section -->
		<div class="text-center mt-12 mb-12 relative">
			<div class="inline-flex items-center gap-2 bg-gradient-to-r from-pink-500/10 to-purple-500/10 border border-pink-500/25 px-3 py-1 rounded-full text-xs font-bold text-pink-400 uppercase tracking-widest mb-6 select-none shadow-sm animate-pulse-slow">
				🚀 Next-Gen VOD Scrubber
			</div>
			
			<h1 class="text-5xl md:text-7xl font-bold mb-6 font-display bg-gradient-to-r from-purple-400 via-pink-400 to-orange-400 bg-clip-text text-transparent drop-shadow-sm tracking-tight leading-tight select-none">
				VOD PLAYER PRO
			</h1>
			
			<p class="text-base md:text-lg text-slate-300 mb-2 max-w-xl mx-auto font-medium leading-relaxed">
				Experience streams with interactive timelines. Scrub through games, synced Spotify soundtracks, and in-game combat logs in perfect synchronization.
			</p>
		</div>
		
		<!-- Direct VOD Grid Integration -->
		<div class="border-t border-white/5 pt-8 mb-16">
			<VodGrid username="noway4u_sir" limit={6} client:load />
		</div>
		
		<!-- Features Section -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 select-none">
			<div class="bg-gradient-to-br from-purple-950/20 via-slate-900/40 to-slate-900/60 border border-purple-500/20 hover:border-purple-400/50 rounded-2xl p-6 shadow-xl transition-all duration-300 transform hover:-translate-y-1 group">
				<div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center text-white text-base font-bold mb-4 shadow-lg shadow-purple-500/20 group-hover:scale-110 transition-transform">
					⚡
				</div>
				<h3 class="text-sm font-bold mb-2 font-display text-purple-300 uppercase tracking-wide">Real-Time Sync</h3>
				<p class="text-xs text-gray-400 font-medium leading-relaxed">
					Perfect synchronization between the video stream, playhead position, and timeline event tracks.
				</p>
			</div>
			
			<div class="bg-gradient-to-br from-blue-950/20 via-slate-900/40 to-slate-900/60 border border-blue-500/20 hover:border-blue-400/50 rounded-2xl p-6 shadow-xl transition-all duration-300 transform hover:-translate-y-1 group">
				<div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center text-white text-base font-bold mb-4 shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform">
					🎵
				</div>
				<h3 class="text-sm font-bold mb-2 font-display text-blue-300 uppercase tracking-wide">Spotify Sync</h3>
				<p class="text-xs text-gray-400 font-medium leading-relaxed">
					Dedicated song timeline. Includes a real-time floating player that identifies VOD music tracks.
				</p>
			</div>
			
			<div class="bg-gradient-to-br from-pink-950/20 via-slate-900/40 to-slate-900/60 border border-pink-500/20 hover:border-pink-400/50 rounded-2xl p-6 shadow-xl transition-all duration-300 transform hover:-translate-y-1 group">
				<div class="w-10 h-10 bg-gradient-to-br from-pink-500 to-pink-600 rounded-xl flex items-center justify-center text-white text-base font-bold mb-4 shadow-lg shadow-pink-500/20 group-hover:scale-110 transition-transform">
					⚔️
				</div>
				<h3 class="text-sm font-bold mb-2 font-display text-pink-300 uppercase tracking-wide">Event Grouping</h3>
				<p class="text-xs text-gray-400 font-medium leading-relaxed">
					Combat clustering groups dense events. Click to auto-zoom the timeline and see match events.
				</p>
			</div>
		</div>
	</div>
</Layout>
