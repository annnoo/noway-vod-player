---
import type { ExtendedVodResponse } from '../../lib/types';
import { fetchStreamPlaylist } from '../../lib/playlist';
import Layout from '../../layouts/Layout.astro';
import TwitchChannelEmbed from '../../components/react/vod/TwitchChannelEmbed';
import EventTimeline from '../../components/react/vod/EventTimeline';
import "../../styles/vod.css";
const { vodId } = Astro.params;
const offset = Astro.url.searchParams.get('offset') || '0';

let vodData: ExtendedVodResponse | null = null;
let error: string | null = null;
const playlist = await fetchStreamPlaylist(vodId!).catch(err => {
	console.error('Error fetching playlist:', err);
	return null;
});
const playlistForEmbed = playlist?.spotifyUrl?.split('https://open.spotify.com/')[1];
let vodTitle = 'Stream-Aufzeichnung';
try {
	const response = await fetch(`http://website-backend.noway.gg/vod/${vodId}/events`);

	
	if (!response.ok) {
		throw new Error(`Failed to load VOD data: ${response.status} ${response.statusText}`);
	}
	
	vodData = await response.json();
	vodTitle = vodData?.events[0]?.timestamp ?
  `Stream vom ${new Date(vodData.events[0].timestamp).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}` : 'Stream-Aufzeichnung';
} catch (err) {
	console.error('Error loading VOD data:', err);
	error = err instanceof Error ? err.message : 'Unknown error occurred';
}

---
<Layout title={`${vodTitle} | Noway4u VODs`} description={`Sieh dir ${vodTitle} mit interaktiver Match-Timeline an.`}>
        <script is:inline src="https://player.twitch.tv/js/embed/v1.js"></script>

	{vodData ? (
		<div class="viewer-page"><div class="viewer-glow" aria-hidden="true"></div><div class="viewer-shell">
			<div class="viewer-heading"><div><a href="/vod" class="back-link">← ZURÜCK ZUM ARCHIV</a><div class="eyebrow"><span class="pulse-dot"></span> STREAM-AUFZEICHNUNG <span class="heading-divider">/</span> NOWAY4U</div><h1>{vodTitle}<span class="mint-dot">.</span></h1></div><div class="viewer-meta"><span>STREAM-DAUER <strong>{Math.floor(vodData.vodDuration / 3600)} Std. {Math.floor(vodData.vodDuration % 3600 / 60)} Min.</strong></span><span>EREIGNISSE <strong>{vodData.totalEvents}</strong></span></div></div>
			<div class="player-layout"><section class="player-panel" aria-label="Videoplayer"><div class="player-panel-top"><span><span class="pulse-dot"></span> VOD PLAYER</span><span>TWITCH <span class="player-top-slash">/</span> NOWAY4U</span></div><div class="player-frame"><TwitchChannelEmbed
								client:load
								video={vodId} 
								id={vodId}
								offsetSeconds={Number.isFinite(Number(offset)) ? Math.max(0, Number(offset)) : 0}
								width="100%" 
								height="100%" 
							/></div><div class="player-panel-bottom"><span>INTERAKTIVE MATCH-TIMELINE</span><span>↓ UNTER DEM PLAYER</span></div></section>
				<aside class="player-aside viewer-facts"><div class="aside-accent">STREAM-DATEN</div><div class="viewer-fact"><span>AUFZEICHNUNG</span><strong>{vodTitle.replace('Stream vom ', '')}</strong></div><div class="viewer-fact"><span>DAUER</span><strong>{Math.floor(vodData.vodDuration / 3600)} Std. {Math.floor(vodData.vodDuration % 3600 / 60)} Min.</strong></div><div class="viewer-fact"><span>MATCHES</span><strong>{vodData.events.filter(event => event.type === 'GAME').length}</strong></div><div class="viewer-fact"><span>EREIGNISSE</span><strong>{vodData.totalEvents}</strong></div>{playlist && playlistForEmbed && <div class="aside-playlist"><span>STREAM-PLAYLIST</span><iframe title="Spotify-Playlist zum Stream" src={`https://open.spotify.com/embed/${playlistForEmbed}`} allow="encrypted-media" loading="lazy"></iframe></div>}</aside></div>
			<EventTimeline client:load events={vodData.events} vodDuration={vodData.vodDuration} vodId={vodId!} />
		</div></div>
	) : error ? (
		<div class="viewer-error"><h1>VOD konnte nicht geladen werden.</h1><p>Bitte versuche es später erneut.</p><a href="/vod" class="solid-button">Zurück zum Archiv →</a></div>
	) : (
		<div class="viewer-error"><h1>Stream wird geladen …</h1></div>
	)}
</Layout>
